NODE_ENV=development
PORT=3000
SESSION_SECRET=replace-with-a-long-random-secret
BILLING_DB_PATH=./data/billing.sqlite

# Generated automatically on first "npm start" when empty.
# Keep this key secret and backed up. Changing it makes stored router credentials unreadable.
APP_ENCRYPTION_KEY=

# Set these only when creating the first administrator:
# ADMIN_EMAIL=admin@example.com
# ADMIN_NAME=Administrator
# ADMIN_PASSWORD=use-a-unique-password-at-least-12-characters

# GenieACS NBI must remain private; do not expose it publicly.
GENIEACS_NBI_URL=http://127.0.0.1:7557
GENIEACS_USERNAME=
GENIEACS_PASSWORD=
GENIEACS_NBI_TIMEOUT_MS=8000

# MikroTik credentials will be configured per router in the application.
