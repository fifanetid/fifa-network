<%- include("../partials/header",{title}) %>
<section class="ops-intro"><div><span class="eyebrow">ISP OPERATIONS</span><h2>Operasional jaringan & keuangan</h2><p>Kelola titik distribusi, pengeluaran, dan stok perangkat dari satu tempat.</p></div></section>
<div class="ops-stats"><article><small>Total ODP</small><strong><%= summary.odps %></strong></article><article><small>Pengeluaran bulan ini</small><strong><%= new Intl.NumberFormat("id-ID",{style:"currency",currency:"IDR",maximumFractionDigits:0}).format(summary.expense) %></strong></article><article><small>Stok menipis</small><strong><%= summary.stock %></strong></article></div>
<% if(notice){ %><div class="notice success"><%= notice %></div><% } %><% if(error){ %><div class="notice error"><%= error %></div><% } %>
<nav class="ops-tabs"><a class="<%= tab==='odp'?'active':'' %>" href="/admin/operations?tab=odp">ODP & Pemetaan</a><a class="<%= tab==='expenses'?'active':'' %>" href="/admin/operations?tab=expenses">Pengeluaran</a><a class="<%= tab==='inventory'?'active':'' %>" href="/admin/operations?tab=inventory">Inventaris</a></nav>
<% if(tab==='odp'){ %><section class="panel ops-panel"><h3>Tambah titik ODP</h3><form method="post" action="/admin/operations/odp" class="ops-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Kode ODP<input name="odp_code" required maxlength="40" placeholder="ODP-001"></label><label>Nama<input name="name" required maxlength="100"></label><label>Alamat<input name="address" maxlength="500"></label><label>Latitude<input name="latitude" type="number" step="any"></label><label>Longitude<input name="longitude" type="number" step="any"></label><label>Kapasitas port<input name="port_capacity" type="number" min="1" max="256" value="8"></label><button class="primary-button">Simpan ODP</button></form><div class="table-wrap"><table class="users-table"><thead><tr><th>Kode</th><th>Nama / Alamat</th><th>Koordinat</th><th>Kapasitas</th><th>Pelanggan</th><th>Status</th></tr></thead><tbody><% odps.forEach(o=>{ %><tr><td><strong><%= o.odp_code %></strong></td><td><%= o.name %><small><%= o.address||'-' %></small></td><td><%= o.latitude===null?'-':o.latitude+', '+o.longitude %></td><td><%= o.port_capacity %></td><td><%= o.customer_count %></td><td><%= o.status %></td></tr><% }) %></tbody></table></div></section>
<% }else if(tab==='expenses'){ %><section class="panel ops-panel"><h3>Catat pengeluaran operasional</h3><form method="post" action="/admin/operations/expenses" class="ops-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Deskripsi<input name="description" required maxlength="240"></label><label>Nominal (Rp)<input name="amount_idr" type="number" min="1" step="1" required></label><label>Tanggal<input name="expense_date" type="date" required></label><label>Kategori<select name="category_id"><option value="">Tanpa kategori</option><% categories.forEach(c=>{ %><option value="<%= c.id %>"><%= c.name %></option><% }) %></select></label><label>Metode<select name="payment_method"><option value="cash">Tunai</option><option value="bank_transfer">Transfer</option><option value="qris">QRIS</option><option value="other">Lainnya</option></select></label><label>Vendor<input name="vendor" maxlength="120"></label><button class="primary-button">Simpan pengeluaran</button></form><h3>Kategori pengeluaran</h3><form method="post" action="/admin/operations/expense-category" class="ops-inline"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input name="name" required placeholder="Contoh: Operasional"><button class="small-button">Tambah kategori</button></form><div class="table-wrap"><table class="users-table"><thead><tr><th>Tanggal</th><th>Nomor</th><th>Deskripsi</th><th>Kategori</th><th>Nominal</th><th>Metode</th></tr></thead><tbody><% expenses.forEach(e=>{ %><tr><td><%= e.expense_date %></td><td><%= e.expense_number %></td><td><%= e.description %><small><%= e.vendor||'' %></small></td><td><%= e.category_name||'-' %></td><td><%= new Intl.NumberFormat("id-ID").format(e.amount_idr) %></td><td><%= e.payment_method %></td></tr><% }) %></tbody></table></div></section>
<% }else{ %><section class="panel ops-panel"><h3>Tambah barang inventaris</h3><form method="post" action="/admin/operations/inventory" class="ops-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>SKU<input name="sku" required maxlength="40"></label><label>Nama barang<input name="name" required maxlength="120"></label><label>Kategori<input name="category" required maxlength="60"></label><label>Satuan<input name="unit" value="pcs" maxlength="16"></label><label>Stok minimum<input name="min_quantity" type="number" min="0" value="0"></label><label>Harga satuan (Rp)<input name="unit_cost_idr" type="number" min="0" value="0"></label><label>Lokasi gudang<input name="location"></label><button class="primary-button">Tambah barang</button></form><div class="table-wrap"><table class="users-table"><thead><tr><th>SKU / Barang</th><th>Kategori</th><th>Stok</th><th>Min.</th><th>Lokasi</th><th>Mutasi</th></tr></thead><tbody><% items.forEach(i=>{ %><tr><td><strong><%= i.sku %></strong><small><%= i.name %></small></td><td><%= i.category %></td><td><%= i.quantity %> <%= i.unit %></td><td><%= i.min_quantity %></td><td><%= i.location||'-' %></td><td><form method="post" action="/admin/operations/inventory/<%= i.id %>/movement" class="ops-inline"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><select name="movement_type"><option value="in">Stok masuk</option><option value="out">Stok keluar</option><option value="adjustment">Set stok</option></select><input name="quantity" type="number" min="1" required placeholder="Qty"><input name="reference" placeholder="Referensi"><button class="small-button">Simpan</button></form></td></tr><% }) %></tbody></table></div><h3>Riwayat mutasi stok</h3><div class="table-wrap"><table class="users-table"><thead><tr><th>Waktu</th><th>Barang</th><th>Jenis</th><th>Jumlah</th><th>Referensi</th></tr></thead><tbody><% movements.forEach(m=>{ %><tr><td><%= m.created_at %></td><td><%= m.sku %> — <%= m.item_name %></td><td><%= m.movement_type %></td><td><%= m.quantity %></td><td><%= m.reference||'-' %></td></tr><% }) %></tbody></table></div></section><% } %>
<%- include("../partials/footer") %>