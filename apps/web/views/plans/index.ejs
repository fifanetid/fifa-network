<%- include("../partials/header", { title }) %>
<%
  const monthlyActive = activeTab === "monthly";
  const selectedPackages = monthlyActive ? plans : vouchers;
  const activeCount = selectedPackages.filter(item => item.is_active === 1).length;
  const idr = value => new Intl.NumberFormat("id-ID", {
    style: "currency", currency: "IDR", maximumFractionDigits: 0
  }).format(value);
  const validity = item => item.validity_value + " " + (item.validity_unit === "days" ? "hari" : "jam");
%>

<section class="plan-page-intro plan-unified-intro">
  <div>
    <span class="eyebrow">KATALOG LAYANAN</span>
    <h2>Paket Internet</h2>
    <p>Kelola paket berlangganan bulanan dan paket voucher dari satu tempat.</p>
  </div>
  <span class="plan-page-count"><strong><%= selectedPackages.length %></strong> paket</span>
</section>

<nav class="plan-type-tabs" aria-label="Jenis paket internet">
  <a class="<%= monthlyActive ? 'active' : '' %>" href="/plans?type=monthly" aria-current="<%= monthlyActive ? 'page' : 'false' %>">
    <span class="plan-tab-title">Paket Bulanan</span>
    <small>Langganan rutin</small>
  </a>
  <a class="<%= !monthlyActive ? 'active' : '' %>" href="/plans?type=voucher" aria-current="<%= !monthlyActive ? 'page' : 'false' %>">
    <span class="plan-tab-title">Paket Voucher</span>
    <small>Masa aktif dan kuota</small>
  </a>
</nav>

<% if (notice) { %><div class="notice success"><%= notice %></div><% } %>
<% if (error) { %><div class="notice error"><%= error %></div><% } %>

<section class="plan-summary">
  <article><span>Total paket</span><strong><%= selectedPackages.length %></strong></article>
  <article><span>Paket aktif</span><strong><%= activeCount %></strong></article>
  <article><span>Paket nonaktif</span><strong><%= selectedPackages.length - activeCount %></strong></article>
</section>

<% if (monthlyActive) { %>
  <%- include("./_monthly", { plans }) %>
<% } else { %>
  <%- include("./_voucher", { vouchers }) %>
<% } %>

<%- include("../partials/footer") %>
