<%- include("../partials/header", { title }) %>
<% if (notice) { %><div class="notice success"><%= notice %></div><% } %>
<section class="wa-grid">
  <article class="panel wa-card">
    <div class="panel-heading"><div><span class="eyebrow">WHATSAPP WEB</span><h3>Koneksi perangkat</h3></div><span id="wa-status" class="pill <%= status.status === 'connected' ? 'success' : 'muted' %>"><%= status.status %></span></div>
    <p class="muted-text">Hubungkan nomor WhatsApp operasional FF NETWORK dengan memindai QR dari aplikasi WhatsApp di ponsel.</p>
    <div id="wa-qr-wrap" class="wa-qr-wrap" <%= status.qrDataUrl ? '' : 'hidden' %>><img id="wa-qr" alt="QR WhatsApp untuk ditautkan" src="<%= status.qrDataUrl || '' %>"><p>Buka WhatsApp → Perangkat tertaut → Tautkan perangkat.</p></div>
    <p id="wa-phone" class="wa-phone"><%= status.phone ? 'Terhubung: +' + status.phone : 'Belum terhubung' %></p>
    <p id="wa-error" class="muted-text"><%= status.lastError || '' %></p>
    <div class="wa-actions">
      <form method="post" action="/admin/whatsapp/connect"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="primary-button">Hubungkan / Tampilkan QR</button></form>
      <form method="post" action="/admin/whatsapp/disconnect"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="small-button">Putuskan</button></form>
    </div>
    <small class="muted-text">Sesi tersimpan lokal di data/whatsapp-auth dan tidak dikirim ke GitHub.</small>
  </article>
  <article class="panel wa-card">
    <div class="panel-heading"><div><span class="eyebrow">UJI PENGIRIMAN</span><h3>Kirim pesan tes</h3></div></div>
    <form class="billing-form" method="post" action="/admin/whatsapp/test">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label>Nomor tujuan<input name="phone" inputmode="numeric" placeholder="62812xxxxxxxx" pattern="62[0-9]{8,13}" required></label>
      <label class="wide">Isi pesan<textarea name="message" maxlength="1500">Tes koneksi FF BILLING. Jika pesan ini diterima, WhatsApp Gateway berhasil terhubung.</textarea></label>
      <button class="primary-button">Kirim pesan tes</button>
    </form>
    <div class="divider"></div>
    <div class="panel-heading"><div><span class="eyebrow">PENGINGAT TAGIHAN</span><h3>Jalankan sekarang</h3></div></div>
    <p class="muted-text">Memproses maksimal 20 pengingat untuk pelanggan yang sudah menyetujui WhatsApp. Sistem mencegah pengiriman ganda per invoice dan tahap pengingat.</p>
    <form method="post" action="/admin/whatsapp/reminders/run"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="primary-button">Proses pengingat sekarang</button></form>
    <p class="muted-text">Jadwal tahap: H-3, hari jatuh tempo, H+3, lalu setiap 7 hari selama invoice belum lunas. Batas 20 pesan per proses.</p>

    <div class="divider"></div>
    <div class="wa-scheduler">
      <div class="panel-heading">
        <div><span class="eyebrow">JADWAL OTOMATIS</span><h3>Pengingat harian</h3></div>
        <span class="pill <%= reminderSettings.enabled ? 'success' : 'muted' %>"><%= reminderSettings.enabled ? 'Aktif' : 'Nonaktif' %></span>
      </div>
      <p class="wa-scheduler-time">09.00 WIB · Setiap hari</p>
      <p class="muted-text">Saat aktif, FF BILLING memeriksa tagihan setiap hari pukul 09.00 WIB. Pesan hanya ditujukan kepada pelanggan aktif yang menyetujui WhatsApp. Gateway harus terhubung ketika jadwal berjalan.</p>
      <form method="post" action="/admin/whatsapp/reminders/automatic">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="enabled" value="<%= reminderSettings.enabled ? '0' : '1' %>">
        <button class="primary-button" type="submit"><%= reminderSettings.enabled ? 'Nonaktifkan pengingat otomatis' : 'Aktifkan pengingat otomatis' %></button>
      </form>
      <small class="muted-text">Pengaturan tersimpan di database. Default nonaktif dan dapat diubah kapan saja oleh admin.</small>
    </div>
  </article>
</section>
<section class="panel billing-panel wa-preview-panel">
  <div class="panel-heading">
    <div><span class="eyebrow">PENERIMA PENGINGAT</span><h3>Pratinjau calon penerima berikutnya</h3></div>
    <span class="pill <%= reminderPreview.total ? 'warning' : 'muted' %>"><%= reminderPreview.total %> calon pesan</span>
  </div>
  <p class="muted-text">Tanggal acuan <strong><%= reminderPreview.date %></strong> (Asia/Jakarta). Daftar ini hanya membaca data; tidak ada pesan yang dikirim dari pratinjau. Pengingat yang sudah pernah terkirim pada tahap yang sama otomatis dikecualikan.</p>
  <% if (reminderPreview.total > reminderPreview.candidates.length) { %>
    <p class="muted-text">Menampilkan <%= reminderPreview.candidates.length %> dari <%= reminderPreview.total %> calon pesan. Maksimal 20 pesan diproses dalam satu jadwal.</p>
  <% } %>
  <div class="table-wrap">
    <table class="users-table">
      <thead><tr><th>Pelanggan</th><th>Invoice / Periode</th><th>Jatuh tempo</th><th>Tahap</th><th>Sisa tagihan</th><th>Nomor tujuan</th></tr></thead>
      <tbody>
        <% reminderPreview.candidates.forEach(row => { %>
          <tr>
            <td><strong><%= row.customer_code %></strong><small><%= row.full_name %></small></td>
            <td><strong><%= row.invoice_number %></strong><small><%= row.billing_period %></small></td>
            <td><%= row.due_date %></td>
            <td><span class="pill warning"><%= row.stage_label %></span></td>
            <td><strong><%= new Intl.NumberFormat("id-ID",{style:"currency",currency:"IDR",maximumFractionDigits:0}).format(row.remaining_idr) %></strong></td>
            <td><%= row.masked_phone %></td>
          </tr>
        <% }) %>
        <% if (!reminderPreview.candidates.length) { %>
          <tr><td colspan="6" class="muted-text">Belum ada invoice yang memenuhi jadwal pengingat dari pelanggan aktif yang menyetujui WhatsApp.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</section>
<section class="panel billing-panel">
  <div class="panel-heading"><div><span class="eyebrow">MESSAGE HISTORY</span><h3>Riwayat pesan WhatsApp</h3></div><span class="pill muted"><%= logs.length %> terbaru</span></div>
  <div class="table-wrap"><table class="users-table"><thead><tr><th>Waktu</th><th>Jenis</th><th>Pelanggan / Invoice</th><th>Nomor</th><th>Status</th><th>Keterangan</th></tr></thead><tbody>
  <% logs.forEach(log => { %><tr><td><%= log.created_at %></td><td><%= log.message_type %></td><td><%= log.full_name || '-' %><small><%= log.invoice_number || '-' %></small></td><td><%= log.phone %></td><td><span class="pill <%= log.status === 'sent' ? 'success' : log.status === 'failed' ? 'danger' : 'muted' %>"><%= log.status %></span></td><td><%= log.error_message || '-' %></td></tr><% }) %>
  <% if (!logs.length) { %><tr><td colspan="6" class="muted-text">Belum ada riwayat pesan.</td></tr><% } %>
  </tbody></table></div>
</section>
<script>
(() => {
  const status = document.getElementById("wa-status");
  const qrWrap = document.getElementById("wa-qr-wrap");
  const qr = document.getElementById("wa-qr");
  const phone = document.getElementById("wa-phone");
  const error = document.getElementById("wa-error");
  async function refresh() {
    try {
      const response = await fetch("/admin/whatsapp/status", { headers: { "Accept": "application/json" } });
      if (!response.ok) return;
      const data = await response.json();
      status.textContent = data.status;
      status.className = "pill " + (data.status === "connected" ? "success" : "muted");
      qrWrap.hidden = !data.qrDataUrl;
      if (data.qrDataUrl) qr.src = data.qrDataUrl;
      phone.textContent = data.phone ? "Terhubung: +" + data.phone : "Belum terhubung";
      error.textContent = data.lastError || "";
    } catch {}
  }
  refresh();
  setInterval(refresh, 2500);
})();
</script>
<%- include("../partials/footer") %>
