<%- include("../partials/header", { title }) %>
<% const rupiah = (n) => new Intl.NumberFormat("id-ID",{style:"currency",currency:"IDR",maximumFractionDigits:0}).format(n); %>
<% if (notice) { %><div class="notice success"><%= notice %></div><% } %>
<% if (error) { %><div class="notice error"><%= error %></div><% } %>
<section class="billing-grid">
  <article class="panel">
    <div class="panel-heading"><div><span class="eyebrow">DATA PELANGGAN</span><h3>Tambah pelanggan</h3></div><span class="pill muted"><%= customers.length %> data</span></div>
    <form class="billing-form" method="post" action="/billing/customers">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label>Kode pelanggan<input name="customer_code" maxlength="30" required placeholder="FN-0001"></label>
      <label>Nama lengkap<input name="full_name" maxlength="120" required></label>
      <label>Nomor telepon<input name="phone" maxlength="30" required></label>
      <label>Email (opsional)<input type="email" name="email" maxlength="254"></label>
      <label class="wide">Alamat<textarea name="address" maxlength="500" required></textarea></label>
      <label>No. identitas (opsional)<input name="identity_number" maxlength="80"></label>
      <label>Catatan<input name="notes" maxlength="500"></label>
      <button class="primary-button" type="submit">Simpan pelanggan</button>
    </form>
  </article>
  <article class="panel">
    <div class="panel-heading"><div><span class="eyebrow">PAKET INTERNET</span><h3>Tambah paket</h3></div><span class="pill muted"><%= plans.length %> paket</span></div>
    <% if (currentUser.role === "admin") { %>
    <form class="billing-form" method="post" action="/billing/plans">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label>Kode paket<input name="plan_code" maxlength="30" required placeholder="FIF10"></label>
      <label>Nama paket<input name="name" maxlength="100" required placeholder="FIFA 10 Mbps"></label>
      <label>Kecepatan (Mbps)<input type="number" name="speed_mbps" min="1" max="100000" required></label>
      <label>Harga per bulan (IDR)<input type="number" name="monthly_price_idr" min="0" step="1" required></label>
      <label class="wide">Deskripsi<input name="description" maxlength="500"></label>
      <button class="primary-button" type="submit">Simpan paket</button>
    </form>
    <% } else { %><p class="muted-text">Hanya admin yang dapat mengubah paket internet.</p><% } %>
  </article>
</section>

<section class="panel billing-panel">
  <div class="panel-heading"><div><span class="eyebrow">CUSTOMER DATABASE</span><h3>Daftar pelanggan</h3></div></div>
  <div class="table-wrap"><table class="users-table"><thead><tr><th>Kode / Nama</th><th>Kontak</th><th>Alamat</th><th>Status</th><th>Ubah data</th><th>Aksi</th></tr></thead><tbody>
  <% customers.forEach(c => { %><tr><td><strong><%= c.customer_code %></strong><small><%= c.full_name %></small></td><td><%= c.phone %><small><%= c.email || "-" %></small></td><td><%= c.address %></td><td><span class="pill <%= c.status === 'active' ? 'success' : 'muted' %>"><%= c.status %></span></td><td><details><summary>Edit</summary><form class="mini-edit" method="post" action="/billing/customers/<%= c.id %>/update"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input name="customer_code" value="<%= c.customer_code %>" required><input name="full_name" value="<%= c.full_name %>" required><input name="phone" value="<%= c.phone %>" required><input name="email" value="<%= c.email || '' %>"><input name="address" value="<%= c.address %>" required><input name="identity_number" value="<%= c.identity_number || '' %>"><input name="notes" value="<%= c.notes || '' %>"><button class="small-button">Simpan</button></form></details></td><td><form method="post" action="/billing/customers/<%= c.id %>/status"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="small-button"><%= c.status === "active" ? "Nonaktifkan" : "Aktifkan" %></button></form></td></tr><% }) %>
  <% if (!customers.length) { %><tr><td colspan="6" class="muted-text">Belum ada pelanggan.</td></tr><% } %>
  </tbody></table></div>
</section>

<section class="panel billing-panel">
  <div class="panel-heading"><div><span class="eyebrow">INTERNET CATALOG</span><h3>Paket internet</h3></div></div>
  <div class="table-wrap"><table class="users-table"><thead><tr><th>Kode / Paket</th><th>Kecepatan</th><th>Harga / bulan</th><th>Status</th><th>Ubah</th><th>Aksi</th></tr></thead><tbody>
  <% plans.forEach(p => { %><tr><td><strong><%= p.plan_code %></strong><small><%= p.name %></small></td><td><%= p.speed_mbps %> Mbps</td><td><%= rupiah(p.monthly_price_idr) %></td><td><span class="pill <%= p.is_active ? 'success' : 'muted' %>"><%= p.is_active ? "Aktif" : "Nonaktif" %></span></td><td><% if(currentUser.role === "admin"){ %><details><summary>Edit</summary><form class="mini-edit" method="post" action="/billing/plans/<%= p.id %>/update"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input name="plan_code" value="<%= p.plan_code %>" required><input name="name" value="<%= p.name %>" required><input type="number" name="speed_mbps" value="<%= p.speed_mbps %>" min="1" required><input type="number" name="monthly_price_idr" value="<%= p.monthly_price_idr %>" min="0" required><input name="description" value="<%= p.description || '' %>"><button class="small-button">Simpan</button></form></details><% } %></td><td><% if(currentUser.role === "admin"){ %><form method="post" action="/billing/plans/<%= p.id %>/status"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="small-button"><%= p.is_active ? "Nonaktifkan" : "Aktifkan" %></button></form><% } %></td></tr><% }) %>
  <% if (!plans.length) { %><tr><td colspan="6" class="muted-text">Belum ada paket internet.</td></tr><% } %>
  </tbody></table></div>
</section>

<section class="panel billing-panel">
  <div class="panel-heading"><div><span class="eyebrow">SERVICE MANAGEMENT</span><h3>Buat langganan</h3></div></div>
  <form class="billing-form" method="post" action="/billing/subscriptions">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label>Pelanggan<select name="customer_id" required><option value="">Pilih pelanggan</option><% customers.filter(c=>c.status==="active").forEach(c=>{ %><option value="<%= c.id %>"><%= c.customer_code %> — <%= c.full_name %></option><% }) %></select></label>
    <label>Paket<select name="plan_id" required><option value="">Pilih paket</option><% plans.filter(p=>p.is_active).forEach(p=>{ %><option value="<%= p.id %>"><%= p.plan_code %> — <%= p.name %> (<%= rupiah(p.monthly_price_idr) %>)</option><% }) %></select></label>
    <label>Tanggal mulai<input type="date" name="start_date" required></label>
    <label>Tanggal billing (1–28)<input type="number" name="billing_day" value="1" min="1" max="28" required></label>
    <label>Referensi perangkat eksternal (opsional)<input name="external_device_ref" maxlength="150" placeholder="GenieACS device ID / serial"></label>
    <label>Catatan<input name="notes" maxlength="500"></label>
    <button class="primary-button">Buat langganan</button>
  </form>
  <div class="table-wrap"><table class="users-table"><thead><tr><th>Pelanggan</th><th>Paket</th><th>Mulai</th><th>Referensi perangkat</th><th>Status</th><th>Ubah status</th></tr></thead><tbody>
  <% subscriptions.forEach(s=>{ %><tr><td><strong><%= s.customer_code %></strong><small><%= s.full_name %></small></td><td><%= s.plan_name %><small><%= rupiah(s.monthly_price_idr) %></small></td><td><%= s.start_date %></td><td><%= s.external_device_ref || "-" %></td><td><%= s.status %></td><td><form method="post" action="/billing/subscriptions/<%= s.id %>/status"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><select name="status"><% ["active","suspended","terminated"].forEach(st=>{ %><option value="<%= st %>" <%= s.status===st?"selected":"" %>><%= st %></option><% }) %></select><button class="small-button">Simpan</button></form></td></tr><% }) %>
  <% if(!subscriptions.length){ %><tr><td colspan="6" class="muted-text">Belum ada langganan.</td></tr><% } %>
  </tbody></table></div>
</section>

<section class="panel billing-panel">
  <div class="panel-heading"><div><span class="eyebrow">ACCOUNTS RECEIVABLE</span><h3>Buat invoice</h3></div></div>
  <p class="muted-text">Terbitkan invoice sekaligus untuk semua langganan aktif pada periode yang dipilih. Invoice yang sudah ada akan dilewati agar tidak terduplikasi.</p>
  <form class="billing-form" method="post" action="/billing/invoices/generate">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label>Periode tagihan<input type="month" name="billing_period" required></label>
    <label>Jatuh tempo<input type="date" name="due_date" required></label>
    <label class="wide">Catatan invoice (opsional)<input name="notes" maxlength="500"></label>
    <button class="primary-button" type="submit">Generate invoice semua langganan aktif</button>
  </form>
  <div class="divider"></div>
  <h3>Invoice satu langganan</h3>
  <form class="billing-form" method="post" action="/billing/invoices">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label>Langganan<select name="subscription_id" required><option value="">Pilih langganan</option><% subscriptions.filter(s=>s.status!=="terminated").forEach(s=>{ %><option value="<%= s.id %>"><%= s.customer_code %> — <%= s.full_name %> / <%= s.plan_name %></option><% }) %></select></label>
    <label>Periode tagihan<input type="month" name="billing_period" required></label>
    <label>Jatuh tempo<input type="date" name="due_date" required></label>
    <label>Diskon (IDR)<input type="number" name="discount_idr" min="0" step="1" value="0"></label>
    <label class="wide">Catatan<input name="notes" maxlength="500"></label>
    <button class="primary-button">Terbitkan invoice</button>
  </form>
  <div class="table-wrap"><table class="users-table"><thead><tr><th>Invoice</th><th>Pelanggan / Periode</th><th>Total</th><th>Dibayar</th><th>Sisa</th><th>Status</th><th>Aksi</th></tr></thead><tbody>
  <% invoices.forEach(i=>{ const remaining=i.total_idr-i.paid_idr; %><tr><td><strong><%= i.invoice_number %></strong><small>Jatuh tempo: <%= i.due_date %></small></td><td><%= i.full_name %><small><%= i.billing_period %></small></td><td><%= rupiah(i.total_idr) %></td><td><%= rupiah(i.paid_idr) %></td><td><%= rupiah(remaining) %></td><td><span class="pill <%= i.status==='paid'?'success':'muted' %>"><%= i.status %></span></td><td><% if(i.status!=="paid"&&i.status!=="void"){ %><details><summary>Catat pembayaran</summary><form class="mini-edit" method="post" action="/billing/invoices/<%= i.id %>/payments"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="number" name="amount_idr" min="1" max="<%= remaining %>" placeholder="Nominal IDR" required><select name="payment_method"><option value="cash">Tunai</option><option value="bank_transfer">Transfer bank</option><option value="qris">QRIS</option><option value="other">Lainnya</option></select><input type="date" name="paid_at" required><input name="notes" placeholder="Catatan"><button class="small-button">Simpan pembayaran</button></form></details><% } %><% if(currentUser.role==="admin"&&i.status!=="void"&&i.paid_idr===0){ %><form method="post" action="/billing/invoices/<%= i.id %>/void"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="small-button">Batalkan</button></form><% } %></td></tr><% }) %>
  <% if(!invoices.length){ %><tr><td colspan="7" class="muted-text">Belum ada invoice.</td></tr><% } %>
  </tbody></table></div>
</section>
<section class="panel billing-panel"><div class="panel-heading"><div><span class="eyebrow">PAYMENT HISTORY</span><h3>Riwayat pembayaran</h3></div></div>
<div class="table-wrap"><table class="users-table"><thead><tr><th>Referensi</th><th>Invoice</th><th>Nominal</th><th>Metode</th><th>Tanggal</th><th>Catatan</th></tr></thead><tbody>
<% payments.forEach(p=>{ const refundable=p.amount_idr-p.reversed_idr; %><tr><td><strong><%= p.payment_reference %></strong><small>Dikembalikan: <%= rupiah(p.reversed_idr) %></small></td><td><%= p.invoice_number %></td><td><%= rupiah(p.amount_idr) %><small>Net: <%= rupiah(refundable) %></small></td><td><%= p.payment_method %></td><td><%= p.paid_at %></td><td><%= p.notes || "-" %><% if(currentUser.role==="admin"&&refundable>0){ %><details><summary>Reversal</summary><form class="mini-edit" method="post" action="/billing/payments/<%= p.id %>/reversals"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="number" name="amount_idr" min="1" max="<%= refundable %>" placeholder="Nominal reversal" required><input name="reason" minlength="5" maxlength="500" placeholder="Alasan koreksi (wajib)" required><button class="small-button">Catat reversal</button></form></details><% } %></td></tr><% }) %>
<% if(!payments.length){ %><tr><td colspan="6" class="muted-text">Belum ada pembayaran.</td></tr><% } %>
</tbody></table></div></section>
<section class="panel billing-panel"><div class="panel-heading"><div><span class="eyebrow">REVERSAL AUDIT</span><h3>Riwayat pembalikan pembayaran</h3></div></div>
<div class="table-wrap"><table class="users-table"><thead><tr><th>Referensi reversal</th><th>Referensi pembayaran</th><th>Invoice</th><th>Nominal</th><th>Alasan</th><th>Waktu</th></tr></thead><tbody>
<% reversals.forEach(r=>{ %><tr><td><%= r.reversal_reference %></td><td><%= r.payment_reference %></td><td><%= r.invoice_number %></td><td><%= rupiah(r.amount_idr) %></td><td><%= r.reason %></td><td><%= r.reversed_at %></td></tr><% }) %>
<% if(!reversals.length){ %><tr><td colspan="6" class="muted-text">Belum ada reversal.</td></tr><% } %>
</tbody></table></div></section>
<%- include("../partials/footer") %>
