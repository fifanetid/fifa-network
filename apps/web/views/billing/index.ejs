<%- include("../partials/header", { title }) %>

<div class="customer-management-screen">
<% const rupiah = (n) => new Intl.NumberFormat("id-ID",{style:"currency",currency:"IDR",maximumFractionDigits:0}).format(n); %>
<% if (notice) { %><div class="notice success"><%= notice %></div><% } %>
<% if (error) { %><div class="notice error"><%= error %></div><% } %>
<%
  const activeCustomerCount = customers.filter(c => c.status === "active").length;
  const inactiveCustomerCount = customers.length - activeCustomerCount;
  const unpaidInvoiceCount = customers.reduce((sum, c) => sum + Number(c.unpaid_invoice_count || 0), 0);
  const planOptions = [...new Set(customers.map(c => c.current_plan_name).filter(Boolean))].sort((a,b) => a.localeCompare(b));
%>

<section class="customer-overview">
  <article class="metric-total"><span>Total pelanggan</span><strong><%= customers.length %></strong></article>
  <article class="metric-active"><span>Aktif</span><strong><%= activeCustomerCount %></strong></article>
  <article class="metric-suspended"><span>Nonaktif</span><strong><%= inactiveCustomerCount %></strong></article>
  <article class="metric-billing"><span>Tagihan belum lunas</span><strong><%= unpaidInvoiceCount %></strong></article>
</section>

<section class="customer-list-panel">
  <div class="customer-list-heading">
    <div class="customer-list-title">
      <span class="eyebrow">DATABASE PELANGGAN</span>
      <h2>Daftar Pelanggan <span>(<%= customers.length %>)</span></h2>
    </div>
    <div class="customer-toolbar-actions">
      <button class="customer-tool-button" type="button" id="printCustomers"><span>⎙</span> Cetak</button>
      <button class="customer-tool-button" type="button" id="exportCustomers"><span>⇩</span> Export CSV</button>
      <details class="customer-create-disclosure" <%= openCustomerForm ? "open" : "" %>>
        <summary class="customer-add-button"><span>＋</span> Tambah Pelanggan</summary>
        <button class="customer-modal-backdrop" type="button" aria-label="Tutup formulir tambah pelanggan" onclick="this.closest('details.customer-create-disclosure').open=false"></button>
        <form class="customer-create-form customer-simple-form" method="post" action="/billing/customers">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="customer-modal-heading">
            <div><span class="eyebrow">MANAJEMEN PELANGGAN</span><h3>Tambah Pelanggan Baru</h3><p>Lengkapi data pelanggan dan pilih layanan bila diperlukan.</p></div>
            <button class="customer-modal-close" type="button" aria-label="Tutup" onclick="this.closest('details').open=false">×</button>
          </div>
          <div class="customer-modal-scroll">
            <% if (customerFormError) { %><div class="customer-form-error" role="alert"><%= customerFormError %></div><% } %>

            <section class="customer-form-section">
              <div class="customer-section-heading"><span class="customer-section-icon">▣</span><div><h4>Informasi Pribadi Pelanggan</h4><p>Identitas dan kontak utama pelanggan</p></div></div>
              <div class="customer-simple-grid">
                <label>Nama lengkap <b>*</b><input name="full_name" maxlength="120" required placeholder="Nama pelanggan"></label>
                <label>No. telepon / WhatsApp <b>*</b><input name="phone" maxlength="30" required placeholder="08xxxxxxxxxx"></label>
                <label>ID pelanggan <b>*</b><input name="customer_code" maxlength="30" required placeholder="Contoh: FN-0001"></label>
                <label>NIK / No. KTP <span class="customer-optional">Opsional</span><input name="identity_number" maxlength="80" placeholder="Nomor identitas"></label>
                <label>Email <span class="customer-optional">Opsional</span><input type="email" name="email" maxlength="254" placeholder="nama@email.com"></label>
                <label class="customer-field-wide">Alamat lengkap <b>*</b><textarea name="address" maxlength="500" required placeholder="Jalan, RT/RW, desa, kecamatan"></textarea></label>
              </div>
            </section>

            <details class="customer-extra-fields customer-subscription-fields">
              <summary><span class="customer-section-icon">⌁</span> Paket & Akses Layanan</summary>
              <p class="customer-extra-help">Pilih paket bulanan untuk sekaligus membuat langganan pelanggan.</p>
              <div class="customer-extra-grid">
                <label class="customer-field-wide">Paket internet
                  <select name="plan_id">
                    <option value="">— Belum pilih paket —</option>
                    <% plans.filter(plan => plan.is_active === 1).forEach(plan => { %>
                      <option value="<%= plan.id %>"><%= plan.plan_code %> · <%= plan.name %> · <%= plan.speed_mbps %> Mbps · <%= rupiah(plan.monthly_price_idr) %>/bulan</option>
                    <% }) %>
                  </select>
                </label>
                <label>Tanggal mulai langganan<input type="date" name="start_date"></label>
                <label>Tanggal billing (1–28)<input type="number" name="billing_day" min="1" max="28" value="1"></label>
                <label class="customer-field-wide">Referensi perangkat <span class="customer-optional">Opsional</span><input name="external_device_ref" maxlength="150" placeholder="Serial ONU / ID perangkat"></label>
                <label class="customer-field-wide">Catatan layanan <span class="customer-optional">Opsional</span><textarea name="subscription_notes" maxlength="500" placeholder="Catatan terkait layanan"></textarea></label>
              </div>
            </details>

            <details class="customer-extra-fields customer-portal-fields">
              <summary><span class="customer-section-icon">♙</span> Penagihan, Status & Akses Portal</summary>
              <p class="customer-extra-help">Buat akun portal agar pelanggan dapat melihat invoice dan mengirim konfirmasi pembayaran.</p>
              <% if (currentUser.role === "admin") { %>
                <label class="customer-consent">
                  <input type="checkbox" name="create_portal_account" value="1" data-portal-enable>
                  <span><strong>Buat akses portal sekarang</strong><small>ID login menggunakan ID pelanggan yang diisi di atas.</small></span>
                </label>
                <label class="customer-portal-password">Password sementara (minimal 12 karakter)
                  <input type="password" name="portal_password" minlength="12" maxlength="200" autocomplete="new-password" placeholder="Masukkan password portal" data-portal-password disabled>
                </label>
              <% } else { %>
                <p class="customer-extra-help">Akses portal hanya dapat dibuat oleh admin.</p>
              <% } %>
              <label class="customer-consent customer-consent-spaced">
                <input type="checkbox" name="whatsapp_opt_in" value="1">
                <span><strong>Setuju menerima pengingat WhatsApp</strong><small>Aktifkan hanya jika pelanggan telah memberikan persetujuan.</small></span>
              </label>
            </details>

            <details class="customer-extra-fields">
              <summary><span class="customer-section-icon">☷</span> Catatan Tambahan</summary>
              <div class="customer-extra-grid">
                <label class="customer-field-wide">Catatan internal <span class="customer-optional">Opsional</span><textarea name="notes" maxlength="500" placeholder="Catatan tambahan untuk pelanggan"></textarea></label>
              </div>
            </details>
          </div>
          <div class="customer-form-actions">
            <button class="customer-modal-secondary" type="button" onclick="this.closest('details.customer-create-disclosure').open=false">Batal</button>
            <button class="customer-modal-primary" type="submit">✓ Simpan Pelanggan</button>
          </div>
        </form>
      </details>
    </div>
  </div>

  <div class="customer-filterbar">
    <label class="customer-search-wrap"><span>⌕</span><input id="customerSearch" type="search" placeholder="Cari nama, telepon, ID pelanggan..." aria-label="Cari pelanggan"></label>
    <select id="customerStatusFilter" aria-label="Filter status pelanggan">
      <option value="all">Semua status</option>
      <option value="active">Aktif</option>
      <option value="inactive">Nonaktif</option>
    </select>
    <select id="customerPlanFilter" aria-label="Filter paket internet">
      <option value="all">Semua paket</option>
      <% planOptions.forEach(name => { %><option value="<%= name %>"><%= name %></option><% }) %>
    </select>
    <span id="customerVisibleCount"><%= customers.length %> pelanggan</span>
  </div>

  <p class="customer-delete-note">Pelanggan dengan riwayat langganan, invoice, pembayaran, atau WhatsApp tidak dapat dihapus permanen.</p>
  <div class="table-wrap customer-table-scroll">
    <table class="users-table customer-table">
      <thead><tr><th class="customer-no-col">#</th><th>Nama pelanggan</th><th>Telepon / WhatsApp</th><th>Paket</th><th>Alamat</th><th>Status</th><th>Tagihan belum bayar</th><th>Aksi</th></tr></thead>
      <tbody id="customerTableBody">
      <% customers.forEach((c,index) => { %>
        <tr data-customer-row
            data-status="<%= c.status %>"
            data-plan="<%= c.current_plan_name || '' %>"
            data-search="<%= [c.customer_code,c.full_name,c.phone,c.email||'',c.address,c.current_plan_name||''].join(' ').toLowerCase() %>"
            data-export="<%= JSON.stringify([c.customer_code,c.full_name,c.phone,c.email||'',c.current_plan_name||'',c.address,c.status,c.unpaid_invoice_count,c.unpaid_balance_idr]) %>">
          <td class="customer-row-number"><%= index+1 %></td>
          <td class="customer-name-cell"><strong><%= c.full_name %></strong><small>ID: <%= c.customer_code %></small></td>
          <td class="customer-contact-cell"><strong><%= c.phone %></strong><small><%= c.whatsapp_opt_in ? "WhatsApp disetujui" : "WhatsApp belum disetujui" %></small></td>
          <td class="customer-plan-cell">
            <% if (c.current_plan_name) { %>
              <strong><%= c.current_plan_name %></strong>
              <small><%= c.current_plan_speed %> Mbps</small>
              <% if (c.subscription_status) { %><span class="customer-subscription-state <%= c.subscription_status %>"><%= c.subscription_status === "active" ? "Aktif" : (c.subscription_status === "suspended" ? "Suspend" : "Berakhir") %></span><% } %>
            <% } else { %><span class="customer-not-set">Belum berlangganan</span><% } %>
          </td>
          <td class="customer-address-cell"><%= c.address %></td>
          <td><span class="customer-state <%= c.status %>"><i></i><%= c.status === "active" ? "Aktif" : "Nonaktif" %></span></td>
          <td class="customer-billing-cell">
            <% if (c.unpaid_invoice_count > 0) { %>
              <strong class="has-arrears"><%= c.unpaid_invoice_count %> tagihan</strong>
              <small><%= rupiah(c.unpaid_balance_idr) %></small>
            <% } else { %><span class="customer-paid-state">Lunas</span><% } %>
          </td>
          <td class="customer-actions">
            <details class="customer-edit-disclosure">
              <summary class="customer-icon-button" title="Edit pelanggan" aria-label="Edit pelanggan">✎</summary>
              <button class="customer-modal-backdrop" type="button" aria-label="Tutup edit pelanggan" onclick="this.closest('details.customer-edit-disclosure').open=false"></button>
              <form class="customer-edit-form customer-simple-form" method="post" action="/billing/customers/<%= c.id %>/update">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="customer-modal-heading">
                  <div><span class="eyebrow">MANAJEMEN PELANGGAN</span><h3>Edit Pelanggan</h3><p>Perbarui identitas dan kontak pelanggan.</p></div>
                  <button class="customer-modal-close" type="button" aria-label="Tutup" onclick="this.closest('details').open=false">×</button>
                </div>
                <div class="customer-modal-scroll">
                  <section class="customer-form-section">
                    <div class="customer-section-heading"><span class="customer-section-icon">▣</span><div><h4>Informasi Pribadi Pelanggan</h4><p><%= c.customer_code %></p></div></div>
                    <div class="customer-simple-grid">
                      <label>Nama lengkap <b>*</b><input name="full_name" value="<%= c.full_name %>" maxlength="120" required></label>
                      <label>No. telepon / WhatsApp <b>*</b><input name="phone" value="<%= c.phone %>" maxlength="30" required></label>
                      <label>ID pelanggan <b>*</b><input name="customer_code" value="<%= c.customer_code %>" maxlength="30" required></label>
                      <label>NIK / No. KTP<input name="identity_number" value="<%= c.identity_number || '' %>" maxlength="80"></label>
                      <label>Email<input type="email" name="email" value="<%= c.email || '' %>" maxlength="254"></label>
                      <label class="customer-field-wide">Alamat lengkap <b>*</b><textarea name="address" maxlength="500" required><%= c.address %></textarea></label>
                    </div>
                  </section>
                  <details class="customer-extra-fields" <%= c.notes || c.whatsapp_opt_in ? "open" : "" %>>
                    <summary><span class="customer-section-icon">☷</span> Preferensi & Catatan</summary>
                    <div class="customer-extra-grid">
                      <label class="customer-field-wide">Catatan internal<textarea name="notes" maxlength="500"><%= c.notes || '' %></textarea></label>
                      <label class="customer-consent customer-field-wide">
                        <input type="checkbox" name="whatsapp_opt_in" value="1" <%= c.whatsapp_opt_in ? "checked" : "" %>>
                        <span><strong>Setuju menerima pengingat WhatsApp</strong><small>Persetujuan pelanggan untuk pesan tagihan.</small></span>
                      </label>
                    </div>
                  </details>
                </div>
                <div class="customer-form-actions">
                  <button class="customer-modal-secondary" type="button" onclick="this.closest('details.customer-edit-disclosure').open=false">Batal</button>
                  <button class="customer-modal-primary" type="submit">Simpan Perubahan</button>
                </div>
              </form>
            </details>
            <form method="post" action="/billing/customers/<%= c.id %>/status">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="customer-icon-button" type="submit" title="<%= c.status === 'active' ? 'Nonaktifkan' : 'Aktifkan' %> pelanggan" aria-label="<%= c.status === 'active' ? 'Nonaktifkan' : 'Aktifkan' %> pelanggan"><%= c.status === "active" ? "Ⅱ" : "▶" %></button>
            </form>
            <% if (currentUser.role === "admin") { %>
              <% if (c.can_delete) { %>
                <form method="post" action="/billing/customers/<%= c.id %>/delete" onsubmit="return confirm('Hapus permanen pelanggan <%= c.customer_code %>? Akun portal terkait juga akan dihapus. Tindakan ini tidak dapat dibatalkan.')">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button class="customer-icon-button customer-delete-icon" type="submit" title="Hapus pelanggan" aria-label="Hapus pelanggan">▣</button>
                </form>
              <% } else { %>
                <button class="customer-icon-button customer-delete-icon is-disabled" type="button" disabled title="Tidak dapat dihapus karena memiliki riwayat layanan, invoice, pembayaran, atau WhatsApp." aria-label="Pelanggan memiliki riwayat dan tidak dapat dihapus">▣</button>
              <% } %>
            <% } %>
          </td>
        </tr>
      <% }) %>
      <% if (!customers.length) { %><tr><td colspan="8" class="customer-empty-row">Belum ada pelanggan. Gunakan tombol Tambah Pelanggan untuk membuat data pertama.</td></tr><% } %>
      <tr id="customerNoResults" hidden><td colspan="8" class="customer-empty-row">Tidak ada pelanggan yang cocok dengan filter.</td></tr>
      </tbody>
    </table>
  </div>
</section>




<% if (currentUser.role === "admin") { %>
<section class="panel billing-panel">
  <div class="panel-heading"><div><span class="eyebrow">CUSTOMER PORTAL</span><h3>Akses portal pelanggan</h3></div><a class="small-button" href="/customer/login" target="_blank" rel="noopener">Buka portal</a></div>
  <p class="muted-text">Buat atau atur ulang password portal pelanggan. Password disimpan dalam bentuk hash. Sampaikan ID pelanggan dan password sementara melalui saluran pribadi yang aman.</p>
  <details class="billing-disclosure">
    <summary>Kelola akses portal (<%= portalCustomers.length %> pelanggan)</summary>
  <div class="table-wrap billing-table-scroll"><table class="users-table">
    <thead><tr><th>Pelanggan</th><th>Status akun portal</th><th>Login terakhir</th><th>Buat / atur ulang password</th><th>Aksi</th></tr></thead>
    <tbody>
      <% portalCustomers.forEach(c => { %>
        <tr>
          <td><strong><%= c.customer_code %></strong><small><%= c.full_name %></small></td>
          <td>
            <% if (c.portal_active === null) { %><span class="pill muted">Belum dibuat</span>
            <% } else { %><span class="pill <%= c.portal_active ? 'success' : 'muted' %>"><%= c.portal_active ? 'Aktif' : 'Nonaktif' %></span><% } %>
          </td>
          <td><%= c.last_login_at || "-" %></td>
          <td>
            <form class="portal-admin-form" method="post" action="/billing/portal-accounts/<%= c.id %>">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="password" name="password" minlength="12" maxlength="200" required autocomplete="new-password" placeholder="Password sementara (min. 12)">
              <button class="small-button"><%= c.portal_active === null ? "Buat akses" : "Atur ulang" %></button>
            </form>
          </td>
          <td>
            <% if (c.portal_active !== null) { %>
              <form method="post" action="/billing/portal-accounts/<%= c.id %>/status">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button class="small-button"><%= c.portal_active ? "Nonaktifkan" : "Aktifkan" %></button>
              </form>
            <% } %>
          </td>
        </tr>
      <% }) %>
      <% if (!portalCustomers.length) { %><tr><td colspan="5" class="muted-text">Belum ada pelanggan.</td></tr><% } %>
    </tbody>
  </table></div>
  </details>
</section>
<% } %>



<section class="panel billing-panel">
  <div class="panel-heading"><div><span class="eyebrow">SERVICE MANAGEMENT</span><h3>Buat langganan</h3></div></div>
  <details class="billing-disclosure">
    <summary>Buka formulir langganan</summary>
  <form class="billing-form" method="post" action="/billing/subscriptions">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label>Pelanggan<select name="customer_id" required><option value="">Pilih pelanggan</option><% customers.filter(c=>c.status==="active").forEach(c=>{ %><option value="<%= c.id %>"><%= c.customer_code %> — <%= c.full_name %></option><% }) %></select></label>
    <label>Paket<select name="plan_id" required><option value="">Pilih paket</option><% plans.filter(p=>p.is_active).forEach(p=>{ %><option value="<%= p.id %>"><%= p.plan_code %> — <%= p.name %> (<%= rupiah(p.monthly_price_idr) %>)</option><% }) %></select></label>
    <label>Tanggal mulai<input type="date" name="start_date" required></label>
    <label>Tanggal billing (1–28)<input type="number" name="billing_day" value="1" min="1" max="28" required></label>
    <label>Referensi perangkat eksternal (opsional)<input name="external_device_ref" maxlength="150" placeholder="GenieACS device ID / serial"></label>
    <label>Catatan<input name="notes" maxlength="500"></label>
    <button class="primary-button">Buat langganan</button>
  </form>
  </details>
  <details class="billing-disclosure">
    <summary>Lihat daftar langganan (<%= subscriptions.length %>)</summary>
  <div class="table-wrap billing-table-scroll"><table class="users-table"><thead><tr><th>Pelanggan</th><th>Paket</th><th>Mulai</th><th>Referensi perangkat</th><th>Status</th><th>Ubah status</th></tr></thead><tbody>
  <% subscriptions.forEach(s=>{ %><tr><td><strong><%= s.customer_code %></strong><small><%= s.full_name %></small></td><td><%= s.plan_name %><small><%= rupiah(s.monthly_price_idr) %></small></td><td><%= s.start_date %></td><td><%= s.external_device_ref || "-" %></td><td><%= s.status %></td><td><form method="post" action="/billing/subscriptions/<%= s.id %>/status"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><select name="status"><% ["active","suspended","terminated"].forEach(st=>{ %><option value="<%= st %>" <%= s.status===st?"selected":"" %>><%= st %></option><% }) %></select><button class="small-button">Simpan</button></form></td></tr><% }) %>
  <% if(!subscriptions.length){ %><tr><td colspan="6" class="muted-text">Belum ada langganan.</td></tr><% } %>
  </tbody></table></div>
  </details>
</section>

<section class="panel billing-panel">
  <div class="panel-heading"><div><span class="eyebrow">ACCOUNTS RECEIVABLE</span><h3>Buat invoice</h3></div></div>
  <details class="billing-disclosure">
    <summary>Buat invoice baru (manual atau bulanan otomatis)</summary>
  <p class="muted-text">Invoice bulanan otomatis hanya menerbitkan tagihan untuk langganan aktif. Periode yang sudah memiliki invoice akan dilewati.</p>
  <form class="billing-form" method="post" action="/billing/invoices/generate-monthly">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label>Periode tagihan<input type="month" name="billing_period" required></label>
    <label>Jatuh tempo<input type="date" name="due_date" required></label>
    <button class="primary-button" type="submit">Buat invoice bulanan otomatis</button>
  </form>
  <div class="divider"></div>
  <form class="billing-form" method="post" action="/billing/invoices">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label>Langganan<select name="subscription_id" required><option value="">Pilih langganan</option><% subscriptions.filter(s=>s.status!=="terminated").forEach(s=>{ %><option value="<%= s.id %>"><%= s.customer_code %> — <%= s.full_name %> / <%= s.plan_name %></option><% }) %></select></label>
    <label>Periode tagihan<input type="month" name="billing_period" required></label>
    <label>Jatuh tempo<input type="date" name="due_date" required></label>
    <label>Diskon (IDR)<input type="number" name="discount_idr" min="0" step="1" value="0"></label>
    <label class="wide">Catatan<input name="notes" maxlength="500"></label>
    <button class="primary-button">Terbitkan invoice</button>
  </form>
  </details>
  <div class="reminder-summary">
    <strong>Pengingat jatuh tempo</strong>
    <span>Tagihan belum lunas yang jatuh tempo atau akan jatuh tempo dalam 7 hari ke depan.</span>
    <b><%= dueReminders.length %> tagihan perlu ditindaklanjuti</b>
  </div>
  <details class="billing-disclosure">
    <summary>Lihat daftar tagihan yang perlu diingatkan (<%= dueReminders.length %>)</summary>
  <div class="table-wrap billing-table-scroll"><table class="users-table"><thead><tr><th>Status</th><th>Pelanggan</th><th>Invoice</th><th>Jatuh tempo</th><th>Sisa tagihan</th><th>Kontak</th></tr></thead><tbody>
  <% dueReminders.forEach(r=>{ %><tr><td><span class="pill <%= r.is_overdue ? 'danger' : 'warning' %>"><%= r.is_overdue ? 'Terlambat ' + r.days_overdue + ' hari' : (r.days_overdue === 0 ? 'Jatuh tempo hari ini' : 'Dalam ' + Math.abs(r.days_overdue) + ' hari') %></span></td><td><strong><%= r.customer_code %></strong><small><%= r.full_name %></small></td><td><%= r.invoice_number %><small><%= r.billing_period %></small></td><td><%= r.due_date %></td><td><strong><%= rupiah(r.remaining_idr) %></strong></td><td><%= r.phone %></td></tr><% }) %>
  <% if(!dueReminders.length){ %><tr><td colspan="6" class="muted-text">Tidak ada tagihan yang perlu diingatkan dalam 7 hari ke depan.</td></tr><% } %>
  </tbody></table></div>
  </details>
  <details class="billing-disclosure">
    <summary>Lihat semua invoice (<%= invoices.length %>)</summary>
  <div class="table-wrap billing-table-scroll"><table class="users-table"><thead><tr><th>Invoice</th><th>Pelanggan / Periode</th><th>Total</th><th>Dibayar</th><th>Sisa</th><th>Status</th><th>Aksi</th></tr></thead><tbody>
  <% invoices.forEach(i=>{ const remaining=i.total_idr-i.paid_idr; %><tr><td><strong><%= i.invoice_number %></strong><small>Jatuh tempo: <%= i.due_date %></small></td><td><%= i.full_name %><small><%= i.billing_period %></small></td><td><%= rupiah(i.total_idr) %></td><td><%= rupiah(i.paid_idr) %></td><td><%= rupiah(remaining) %></td><td><span class="pill <%= i.status==='paid'?'success':'muted' %>"><%= i.status %></span></td><td><% if(i.status!=="paid"&&i.status!=="void"){ %><details><summary>Catat pembayaran</summary><form class="mini-edit" method="post" action="/billing/invoices/<%= i.id %>/payments"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="number" name="amount_idr" min="1" max="<%= remaining %>" placeholder="Nominal IDR" required><select name="payment_method"><option value="cash">Tunai</option><option value="bank_transfer">Transfer bank</option><option value="qris">QRIS</option><option value="other">Lainnya</option></select><input type="date" name="paid_at" required><input name="notes" placeholder="Catatan"><button class="small-button">Simpan pembayaran</button></form></details><% } %><% if(currentUser.role==="admin"&&i.status!=="void"&&i.paid_idr===0){ %><form method="post" action="/billing/invoices/<%= i.id %>/void"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="small-button">Batalkan</button></form><% } %></td></tr><% }) %>
  <% if(!invoices.length){ %><tr><td colspan="7" class="muted-text">Belum ada invoice.</td></tr><% } %>
  </tbody></table></div>
  </details>
</section>
<section class="panel billing-panel">
  <div class="panel-heading"><div><span class="eyebrow">CUSTOMER PAYMENT REVIEW</span><h3>Konfirmasi pembayaran pelanggan</h3></div><span class="pill muted"><%= paymentConfirmations.filter(c=>c.status==='pending').length %> menunggu</span></div>
  <p class="muted-text">Pembayaran dari portal tidak langsung mengubah saldo invoice. Periksa referensi transaksi dan bukti pada rekening / kanal pembayaran sebelum menyetujui.</p>
  <details class="billing-disclosure" <%= paymentConfirmations.some(c=>c.status==="pending") ? "open" : "" %>>
    <summary>Lihat riwayat konfirmasi (<%= paymentConfirmations.length %>) · <%= paymentConfirmations.filter(c=>c.status==="pending").length %> menunggu</summary>
  <div class="table-wrap billing-table-scroll"><table class="users-table">
    <thead><tr><th>Dikirim</th><th>Pelanggan</th><th>Invoice</th><th>Nominal</th><th>Metode</th><th>Referensi</th><th>Tanggal bayar</th><th>Status / Aksi</th></tr></thead>
    <tbody>
      <% paymentConfirmations.forEach(c => { %>
        <tr>
          <td><%= c.created_at %></td>
          <td><strong><%= c.customer_code %></strong><small><%= c.full_name %></small></td>
          <td><%= c.invoice_number %></td>
          <td><strong><%= rupiah(c.amount_idr) %></strong></td>
          <td><%= c.payment_method %></td>
          <td><%= c.payment_reference %><small><%= c.notes || "-" %></small></td>
          <td><%= c.paid_at %></td>
          <td>
            <% if (c.status === "pending") { %>
              <span class="pill warning">Menunggu</span>
              <form class="portal-review-form" method="post" action="/billing/payment-confirmations/<%= c.id %>/approve">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button class="small-button">Setujui & catat</button>
              </form>
              <details><summary>Tolak</summary><form class="mini-edit" method="post" action="/billing/payment-confirmations/<%= c.id %>/reject">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input name="review_note" minlength="5" maxlength="500" placeholder="Alasan penolakan" required>
                <button class="small-button">Simpan penolakan</button>
              </form></details>
            <% } else { %>
              <% const statusLabels = { approved: "Disetujui", rejected: "Ditolak", reversed: "Dibalik", partially_reversed: "Dibalik sebagian" }; %>
              <span class="pill <%= c.display_status==='approved'?'success':c.display_status==='partially_reversed'?'warning':'danger' %>"><%= statusLabels[c.display_status] || c.display_status %></span>
              <small><%= c.review_note || (c.display_status==='reversed' ? "Pembayaran terkait telah dibalik." : c.display_status==='partially_reversed' ? "Sebagian pembayaran terkait telah dibalik." : "-") %></small>
            <% } %>
          </td>
        </tr>
      <% }) %>
      <% if (!paymentConfirmations.length) { %><tr><td colspan="8" class="muted-text">Belum ada konfirmasi pembayaran pelanggan.</td></tr><% } %>
    </tbody>
  </table></div>
  </details>
</section>

<section class="panel billing-panel"><div class="panel-heading"><div><span class="eyebrow">PAYMENT HISTORY</span><h3>Riwayat pembayaran</h3></div></div>
<details class="billing-disclosure">
  <summary>Lihat riwayat pembayaran (<%= payments.length %>)</summary>
<div class="table-wrap billing-table-scroll"><table class="users-table"><thead><tr><th>Referensi</th><th>Invoice</th><th>Nominal</th><th>Metode</th><th>Tanggal</th><th>Catatan</th></tr></thead><tbody>
<% payments.forEach(p=>{ const refundable=p.amount_idr-p.reversed_idr; %><tr><td><strong><%= p.payment_reference %></strong><small>Dikembalikan: <%= rupiah(p.reversed_idr) %></small></td><td><%= p.invoice_number %></td><td><%= rupiah(p.amount_idr) %><small>Net: <%= rupiah(refundable) %></small></td><td><%= p.payment_method %></td><td><%= p.paid_at %></td><td><%= p.notes || "-" %><% if(currentUser.role==="admin"&&refundable>0){ %><details><summary>Reversal</summary><form class="mini-edit" method="post" action="/billing/payments/<%= p.id %>/reversals"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="number" name="amount_idr" min="1" max="<%= refundable %>" placeholder="Nominal reversal" required><input name="reason" minlength="5" maxlength="500" placeholder="Alasan koreksi (wajib)" required><button class="small-button">Catat reversal</button></form></details><% } %></td></tr><% }) %>
<% if(!payments.length){ %><tr><td colspan="6" class="muted-text">Belum ada pembayaran.</td></tr><% } %>
</tbody></table></div>
</details>
</section>
<section class="panel billing-panel"><div class="panel-heading"><div><span class="eyebrow">REVERSAL AUDIT</span><h3>Riwayat pembalikan pembayaran</h3></div></div>
<details class="billing-disclosure">
  <summary>Lihat riwayat reversal (<%= reversals.length %>)</summary>
<div class="table-wrap billing-table-scroll"><table class="users-table"><thead><tr><th>Referensi reversal</th><th>Referensi pembayaran</th><th>Invoice</th><th>Nominal</th><th>Alasan</th><th>Waktu</th></tr></thead><tbody>
<% reversals.forEach(r=>{ %><tr><td><%= r.reversal_reference %></td><td><%= r.payment_reference %></td><td><%= r.invoice_number %></td><td><%= rupiah(r.amount_idr) %></td><td><%= r.reason %></td><td><%= r.reversed_at %></td></tr><% }) %>
<% if(!reversals.length){ %><tr><td colspan="6" class="muted-text">Belum ada reversal.</td></tr><% } %>
</tbody></table></div>
</details>
</section>
<script>
(() => {
  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return;
    const openDialog = document.querySelector(
      ".customer-create-disclosure[open], .customer-edit-disclosure[open]"
    );
    if (openDialog) {
      openDialog.open = false;
      const trigger = openDialog.querySelector(":scope > summary");
      if (trigger) trigger.focus();
    }
  });

  const portalEnable = document.querySelector("[data-portal-enable]");
  const portalPassword = document.querySelector("[data-portal-password]");
  if (portalEnable && portalPassword) {
    const syncPortalPassword = () => {
      portalPassword.disabled = !portalEnable.checked;
      portalPassword.required = portalEnable.checked;
      if (!portalEnable.checked) portalPassword.value = "";
    };
    portalEnable.addEventListener("change", syncPortalPassword);
    syncPortalPassword();
  }

  const search = document.getElementById("customerSearch");
  const status = document.getElementById("customerStatusFilter");
  const plan = document.getElementById("customerPlanFilter");
  const rows = Array.from(document.querySelectorAll("[data-customer-row]"));
  const count = document.getElementById("customerVisibleCount");
  const empty = document.getElementById("customerNoResults");

  function filterCustomers() {
    const query = search ? search.value.trim().toLowerCase() : "";
    const selectedStatus = status ? status.value : "all";
    const selectedPlan = plan ? plan.value : "all";
    let visible = 0;

    rows.forEach((row) => {
      const matchesText = (row.dataset.search || "").includes(query);
      const matchesStatus = selectedStatus === "all" || row.dataset.status === selectedStatus;
      const matchesPlan = selectedPlan === "all" || row.dataset.plan === selectedPlan;
      const show = matchesText && matchesStatus && matchesPlan;
      row.hidden = !show;
      if (show) visible++;
    });

    if (empty) empty.hidden = visible !== 0;
    if (count) count.textContent = visible + " pelanggan";
  }

  if (search) search.addEventListener("input", filterCustomers);
  if (status) status.addEventListener("change", filterCustomers);
  if (plan) plan.addEventListener("change", filterCustomers);

  const exportButton = document.getElementById("exportCustomers");
  if (exportButton) {
    exportButton.addEventListener("click", () => {
      const headers = [
        "ID Pelanggan", "Nama", "Telepon", "Email", "Paket",
        "Alamat", "Status", "Jumlah Tagihan Belum Lunas", "Sisa Tagihan (IDR)"
      ];
      const visibleRows = rows.filter(row => !row.hidden);
      const csvValue = value => {
        const text = String(value ?? "");
        return '"' + text.replace(/"/g, '""') + '"';
      };
      const csv = [headers, ...visibleRows.map(row => {
        try { return JSON.parse(row.dataset.export || "[]"); }
        catch (_) { return []; }
      })].map(record => record.map(csvValue).join(",")).join("\r\n");
      const blob = new Blob(["\uFEFF", csv], { type: "text/csv;charset=utf-8" });
      const url = URL.createObjectURL(blob);
      const link = document.createElement("a");
      link.href = url;
      link.download = "daftar-pelanggan-" + new Date().toISOString().slice(0,10) + ".csv";
      document.body.appendChild(link);
      link.click();
      link.remove();
      URL.revokeObjectURL(url);
    });
  }

  const printButton = document.getElementById("printCustomers");
  if (printButton) printButton.addEventListener("click", () => window.print());
  filterCustomers();
})();
</script>
</div>
<%- include("../partials/footer") %>
