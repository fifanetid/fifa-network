<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> | FF BILLING</title>
  <link rel="stylesheet" href="/assets/css/app.css">
  <link rel="stylesheet" href="/assets/css/auth.css">
  <link rel="stylesheet" href="/assets/css/billing.css">
  <link rel="stylesheet" href="/assets/css/whatsapp.css">
  <link rel="stylesheet" href="/assets/css/portal.css">
</head>
<body>
<div class="app-shell">
  <aside class="sidebar">
    <div class="brand"><span class="brand-mark">FF</span><div><strong>FF BILLING</strong><small>ISP MANAGEMENT</small></div></div>
    <nav>
      <a href="/">▦ <span>Dashboard</span></a>
      <% if (currentUser && currentUser.role === "admin") { %>
        <a href="/admin/users"><span>♙</span><span>Manajemen Pengguna</span></a>
        <a href="/admin/audit"><span>◷</span><span>Audit Log</span></a>
        <a class="<%= title === 'WhatsApp Gateway' ? 'active' : '' %>" href="/admin/whatsapp"><span>◉</span><span>WhatsApp Gateway</span></a>
        <a href="/customer/login" target="_blank" rel="noopener"><span>♧</span><span>Portal Pelanggan</span></a>
      <% } %>
      <% if (currentUser && ["admin","finance"].includes(currentUser.role)) { %>
        <div class="sidebar-section-label">KATALOG PAKET</div>
        <a class="<%= title === 'Paket Internet Bulanan' ? 'active' : '' %>" href="/plans/monthly"><span>▤</span><span>Paket Internet Bulanan</span></a>
        <a class="<%= title === 'Paket Voucher' ? 'active' : '' %>" href="/plans/voucher"><span>▧</span><span>Paket Voucher</span></a>
        <a class="<%= title === 'Billing & Pelanggan' ? 'active' : '' %>" href="/billing"><span>♙</span><span>Pelanggan & Billing</span></a>
        <a class="<%= title === 'Laporan Keuangan' ? 'active' : '' %>" href="/reports"><span>▥</span><span>Laporan Keuangan</span></a>
      <% } %>
      <a href="#"><span>⌁</span><span>MikroTik (segera)</span></a>
      <a href="#"><span>◎</span><span>GenieACS / ONT (segera)</span></a>
      <a href="#"><span>⚙</span><span>Pengaturan</span></a>
    </nav>
    <div class="sidebar-foot">ISP Billing Platform<br><span>Version 0.5.0 · Development</span></div>
  </aside>
  <main class="main">
    <header class="topbar">
      <div><span class="eyebrow">FF BILLING / ADMIN</span><h1><%= title %></h1></div>
      <div class="user-chip">
        <span class="status-dot"></span><span><%= currentUser ? currentUser.name : "Guest" %></span>
        <% if (currentUser) { %>
          <form method="post" action="/logout" class="inline-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="link-button" type="submit">Keluar</button></form>
        <% } %>
      </div>
    </header>
