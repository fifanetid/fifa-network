<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> | FIFA NETWORK</title>
  <link rel="stylesheet" href="/assets/css/app.css">
  <link rel="stylesheet" href="/assets/css/auth.css">
  <link rel="stylesheet" href="/assets/css/billing.css">
</head>
<body>
<div class="app-shell">
  <aside class="sidebar">
    <div class="brand"><span class="brand-mark">F</span><div><strong>FIFA NETWORK</strong><small>ISP MANAGEMENT</small></div></div>
    <nav>
      <a href="/">▦ <span>Dashboard</span></a>
      <% if (currentUser && currentUser.role === "admin") { %>
        <a href="/admin/users"><span>♙</span><span>Manajemen Pengguna</span></a>
      <% } %>
      <% if (currentUser && ["admin","finance"].includes(currentUser.role)) { %>
        <a class="active" href="/billing"><span>▤</span><span>Pelanggan & Billing</span></a>
      <% } %>
      <a href="#"><span>⌁</span><span>MikroTik (segera)</span></a>
      <a href="#"><span>◎</span><span>GenieACS / ONT (segera)</span></a>
      <a href="#"><span>⚙</span><span>Pengaturan</span></a>
    </nav>
    <div class="sidebar-foot">Custom ISP Platform<br><span>Version 0.5.0 · Development</span></div>
  </aside>
  <main class="main">
    <header class="topbar">
      <div><span class="eyebrow">FIFA NETWORK / ADMIN</span><h1><%= title %></h1></div>
      <div class="user-chip">
        <span class="status-dot"></span><span><%= currentUser ? currentUser.name : "Guest" %></span>
        <% if (currentUser) { %>
          <form method="post" action="/logout" class="inline-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="link-button" type="submit">Keluar</button></form>
        <% } %>
      </div>
    </header>
