<%- include("partials/header", { title }) %>
<section class="welcome">
  <div><span class="eyebrow light">NETWORK OVERVIEW</span><h2>Selamat datang di FIFA NETWORK</h2><p>Kelola pelanggan, billing, router, dan perangkat ONT dari satu tempat.</p></div>
  <div class="welcome-orb">FN</div>
</section>
<section class="stat-grid">
  <% stats.forEach((item, index) => { %>
    <article class="stat-card">
      <div class="stat-top"><span><%= item.label %></span><span class="stat-icon"><%= ["♙","⌁","▤","◎"][index] %></span></div>
      <strong><%= item.value %></strong>
      <small>Belum terhubung ke data produksi</small>
    </article>
  <% }) %>
</section>
<section class="panel-grid">
  <article class="panel">
    <div class="panel-heading"><div><span class="eyebrow">OPERASIONAL</span><h3>Ringkasan jaringan</h3></div><span class="pill muted">Tahap pengembangan</span></div>
    <div class="empty-state"><div class="empty-icon">⌁</div><strong>Integrasi jaringan belum diaktifkan</strong><p>Data MikroTik dan GenieACS akan ditampilkan setelah konfigurasi koneksi dan kredensial dilakukan.</p></div>
  </article>
  <article class="panel quick-panel">
    <span class="eyebrow">MODUL UTAMA</span><h3>Area pengembangan</h3>
    <div class="module-row"><span class="module-icon blue">♙</span><div><strong>Manajemen pelanggan</strong><small>Profil, layanan, dan perangkat</small></div><span class="pill muted">Rencana</span></div>
    <div class="module-row"><span class="module-icon violet">▤</span><div><strong>Billing</strong><small>Paket, invoice, pembayaran</small></div><span class="pill muted">Rencana</span></div>
    <div class="module-row"><span class="module-icon green">◎</span><div><strong>ACS / ONT</strong><small>TR-069 dan provisioning</small></div><span class="pill muted">Rencana</span></div>
  </article>
</section>
<%- include("partials/footer") %>
